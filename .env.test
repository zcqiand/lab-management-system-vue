# .env.test — vitest 测试期覆盖（vitest mode=test 时加载，优先级高于 .env.local）
#
# ADR-0014 + ADR-0012 v0.3.0：dev 用 .env.local（vue → lab-msw HTTP :5200, MSW 模式 off）；
# test 用 .env.test（同源空 baseUrl）。本仓测试用内联 fixtures + vi.mock，
# 不依赖 @lab/management-system-msw/node setupServer（该依赖已移除，ADR-0012）。

VITE_API_BASE_URL=
VITE_API_MODE=msw-http
VITE_SAAS_BASE_URL=http://localhost:5101
SAAS_BASE_URL=http://localhost:5101

# Vite dev server 端口(与 .env.example 对齐)
VITE_DEV_PORT=5203
# OAuth client_id (与 .env.example 对齐)
VITE_SAAS_CLIENT_ID=11111111-1111-1111-1111-111111111111
