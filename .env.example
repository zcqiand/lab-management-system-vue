# lab-management-system-vue — 开发期环境变量模板
#
# 镜像 lab-management-system-react/.env.example。vue 仓 dev port 暂走默认 5173
# （未来可加 VITE_DEV_PORT 走 process.env 同 react）。

# —— 各后端 baseUrl ——
# 空串 = 同源（msw service worker 拦截；同源不适用 nextjs 因为 lab-vue 在 :5173
# 与 nextjs 在 :3001 是不同 origin，必须填绝对地址）
# 改成本地部署时按实际 IP:PORT 填
VITE_BACKEND_URL_MSW=
VITE_BACKEND_URL_NEXTJS=http://localhost:3001
VITE_BACKEND_URL_ASPNETCORE=http://localhost:5000
VITE_BACKEND_URL_SPRINGBOOT=http://localhost:8080

# —— saas-identity-platform（SSO 跳转目标） ——
VITE_SAAS_BASE_URL=http://localhost:3000
SAAS_BASE_URL=http://localhost:3000

# —— Dev server ——
VITE_DEV_PORT=5173

# —— 后端切换 ——
VITE_DEFAULT_BACKEND=msw