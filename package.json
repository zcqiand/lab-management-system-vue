{
  "name": "lab-management-system-vue",
  "version": "0.1.0",
  "description": "Lab Management System — Vue 3.5 + Vite + TS. v0.1.0: scaffold mirroring saas-identity-platform-vue (vue-query client + orval from shared/openapi.yaml).",
  "type": "module",
  "scripts": {
    "gen:shared": "tsx scripts/gen-shared.ts",
    "prebuild": "npm run gen:shared",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src tests --ext .ts,.vue",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "gate": "cd ../.. && python scripts/gate.py -p lab-management-system-vue"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.62.0",
    "axios": "^1.7.7",
    "pinia": "^2.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "jsdom": "^25.0.0",
    "lucide-vue-next": "^0.577.0",
    "orval": "^7.5.0",
    "prettier": "^3.4.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.1.10"
  }
}
