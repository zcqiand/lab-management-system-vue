{
  "schema": 1,
  "suite_version": "0.5.0",
  "project": "lab-management-system-vue",
  "stack": "vue-ts",
  "gates": {
    "L1": {
      "name": "格式",
      "cmd": [
        "npx",
        "--no",
        "prettier",
        "--check",
        "src",
        "tests"
      ],
      "fix": "运行 `npx prettier --write src tests` 后重试。"
    },
    "L2": {
      "name": "静态检查",
      "cmd": [
        "npx",
        "--no",
        "eslint",
        "src",
        "tests",
        "--ext",
        ".ts,.vue"
      ],
      "fix": "逐条修复 eslint。"
    },
    "L3": {
      "name": "类型",
      "cmd": [
        "npx",
        "--no",
        "vue-tsc",
        "--noEmit"
      ],
      "fix": "补全类型。"
    },
    "L4": {
      "name": "测试",
      "cmd": [
        "npx",
        "--no",
        "vitest",
        "run"
      ],
      "fix": "先让测试变绿。"
    }
  },
  "trace_cmd": [
    "npx",
    "--no",
    "vitest",
    "run"
  ],
  "trace_env": {
    "TRACE_MAP": "1"
  },
  "source_dirs": [
    "src"
  ],
  "test_dirs": [
    "tests"
  ]
}
