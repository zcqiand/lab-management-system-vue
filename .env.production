# lab-management-system-vue 生产环境变量(Vite build-time 烘焙)
# deploy/lab-management-system-vue.sh 启动时不需要任何 VITE_* (已编进 dist)

# 后端地址 —— lab 家族现在 backend 用 lab-nextjs (port 8012, nginx 反代到 80)
VITE_API_BASE_URL=https://lab-nextjs.xiangru.uk
VITE_ENABLE_MSW=false
VITE_API_MODE=aspnetcore

# SSO/identity 仓 (saas 仓开 SSO) —— 直连 saas-nextjs,不走本地代理
VITE_SAAS_BASE_URL=https://saas-nextjs.xiangru.uk
SAAS_BASE_URL=https://saas-nextjs.xiangru.uk